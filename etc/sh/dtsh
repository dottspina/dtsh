# Helper shell functions dtsh CI.

thisfile=$(realpath -m "$0")
thisdir=$(dirname "$thisfile")
DTSH_HOME=$(realpath -m "$thisdir/../..")
unset thisfile
unset thisdir

dtsh_clean() {
    if [ -n "$DTSH_HOME" ]; then
        rm -rf "$DTSH_HOME/.pytest_cache"
        rm -rf "$DTSH_HOME/build"
        rm -rf "$DTSH_HOME/dist"
        rm -rf "$DTSH_HOME/src/dtsh.egg-info"
        rm -rf "$DTSH_HOME/src/dtsh/__pycache__"
        rm -rf "$DTSH_HOME/tests/__pycache__"
    fi
}


dtsh_venv() {
    local arg_venv="$1"
    python3.11 -m venv "$arg_venv"
	. "$arg_venv/bin/activate"
    echo "Python venv: $arg_venv"
	pip install -U pip setuptools
    pip install -q "$DTSH_HOME"
}


dtsh_unittests() {
    local test_venv="$DTSH_HOME/tmp-tests/.venv"
    echo '**** Setup unit tests environment'
    dtsh_clean
    dtsh_venv "$test_venv"
    pip install -q ".[test]" || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Run unit tests'
    python3.11 -m pytest tests || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Dispose unit tests environment'
    deactivate
    rm -rf "$DTSH_HOME/tmp-tests"
    echo 'done.'
}


dtsh_build() {
    echo '**** Setup build environment'
    local build_venv="$DTSH_HOME/tmp-build/.venv"
    dtsh_clean
    dtsh_venv "$build_venv"
    pip install -q ".[dist]" || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Build'
    python3.11 -m build || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Dispose build environment'
    deactivate
    rm -rf "$DTSH_HOME/tmp-build"
    echo 'done.'
}


dtsh_dist_test() {
    echo "DTSH_HOME: $DTSH_HOME"
    _dtsh_continue_yn

    dtsh_build
    echo
    echo '**** Setup dist environment'
    local dist_venv="$DTSH_HOME/tmp-dist/.venv"
    dtsh_venv "$dist_venv"
    pip install -q ".[dist]" || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Uploading to TestPyPI'
    # PyPI does not allow for a filename to be reused,
    # even once a project has been deleted and recreated.
    local whl_dist=$(find "$DTSH_HOME"/dist/ -name "*.whl")
    echo "Wheel dist:  $whl_dist"
    echo "WARNING: will publish on TestPyPI!!"
    python3.11 -m twine upload --repository testpypi "$whl_dist" || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Dispose dist environment'
    deactivate
    rm -rf "$DTSH_HOME/tmp-dist"
    echo 'done.'
}


dtsh_dist_release() {
    echo "DTSH_HOME: $DTSH_HOME"
    _dtsh_continue_yn

    dtsh_build
    echo
    echo '**** Setup dist environment'
    local dist_venv="$DTSH_HOME/tmp-dist/.venv"
    dtsh_venv "$dist_venv"
    pip install -q ".[dist]" || _dtsh_abort
    echo 'done.'
    echo
    local whl_dist=$(find "$DTSH_HOME"/dist/ -name "*.whl")
    local src_dist=$(find "$DTSH_HOME"/dist/ -name "*.tar.gz")
    echo "Source dist: $src_dist"
    echo "Wheel dist:  $whl_dist"
    echo "WARNING: will publish on PyPI!!"
    _dtsh_continue_yn
    echo '**** Uploading to PyPI'
    python3.11 -m twine upload "$src_dist" "$whl_dist" || _dtsh_abort
    echo 'done.'
    echo
    echo '**** Dispose dist environment'
    deactivate
    rm -rf "$DTSH_HOME/tmp-dist"
    echo 'done.'
}

# Continue/abort prompt.
_dtsh_continue_yn() {
    local arg_msg="$1"
    if [ -n "$arg_msg" ]; then
        echo "$arg_msg"
    fi
    echo -n 'Continue [yN]: '
    read yes_no
    case "$yes_no" in
        y|Y)
            ;;
        *)
			echo "Goodbye."
            # Exit the function stack without exiting shell.
			_dtsh_abort
			;;
    esac
}

# Output optional message to stderr
# and exit the function stack without exiting shell.
_dtsh_abort() {
    if [ -n "$1" ]; then
        echo "$1" 1>&2
    fi

    kill -INT $$
}
