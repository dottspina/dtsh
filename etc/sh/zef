# Zef like Zephyr and the Mediterranean wind.
#
# Helper shell functions to work with Zephyr command line
# environments and West workspaces:
# - zef_activate: Setup Zephyr command line environment
# - zef_deactivate: Restore system command line environment
# - zef_env: Dump Zephyr command line environment

# Zephyr board aliases file. Location specified by ZEPHYR_BOARD_ALIASES.
# https://docs.zephyrproject.org/latest/develop/beyond-GSG.html#board-aliases
ZEF_XDG_DIR=$(realpath -m "$HOME/.config/zef")
ZEF_XDG_BOARD_ALIASES="$ZEF_XDG_DIR/board_aliases.cmake"

# West workspace root: set by zef_activate, unset by zef_deactivate.
#
# ZEF_WORKSPACE
# ├── bootloader
# ├── modules
# ├── tools
# ├── .venv
# ├── .west
# ├── zephyr
# └── zephyr-sdk-0.17.4 (example)
ZEF_WORKSPACE=

# Identify current shell for West completion (bash, zsh),
# should not change after this is sourced.
if [ -n "$BASH_VERSION" ]; then
    ZEF_COMP_SH=bash
elif [ -n "$ZSH_VERSION" ]; then
    ZEF_COMP_SH=zsh
else
    ZEF_COMP_SH=
fi

# Setup a Zephyr command line environment:
# - activate the Python environment found in the West workspace
# - set ZEPHYR_BASE (and ZEPHYR_BOARD_ALIASES if aliases file found)
# - configure the toolchain environment variables,
#   prepend toolchain bin directory to PATH
# - configure West completion for Bash or Zsh
#
# SYNOPSIS
#   zef_activate WORKSPACE TOOLCHAIN
#
#   WORKSPACE: path to a Zephyr West workspace
#   TOOLCHAIN: path to the toolchain (GNU Arm Toolchain, or Zephyr SDK)
#
zef_activate() {
    _zef_assert_no_workspace

    if [ -z "$1" ]; then
        _zef_abort 'which workspace ?'
    fi
    workspace_dir=$(realpath -m "$1")
    _zef_assert_dir "$workspace_dir"

    if [ -z "$2" ]; then
        _zef_abort 'which toolchain ?'
    fi
    toolchain_dir=$(realpath -m "$2")
    _zef_assert_dir "$toolchain_dir"

    _zef_workspace_set "$workspace_dir"
    _zef_toolchain_set "$toolchain_dir"
	_zef_board_aliases_set

    ZEF_WORKSPACE="$workspace_dir"
    zef_dump

    _zef_wcomp_init
}

zef_deactivate() {
    _zef_assert_workspace

    _zef_wcomp_deinit
	_zef_board_aliases_unset
    _zef_toolchain_unset
    _zef_workspace_unset
}

zef_dump() {
    _zef_assert_workspace

    echo "Workspace: $ZEF_WORKSPACE"
    _zef_env_python
    _zef_env_zephyr
    _zef_env_toolchain
}


################################################################################

_zef_workspace_set() {
    workspace_venv="$1/.venv"
    _zef_assert_dir "$workspace_venv"

    workspace_zephyr="$1/zephyr"
    _zef_assert_dir "$workspace_zephyr"

    # shellcheck disable=SC1072,SC1091
    . "$workspace_venv/bin/activate" || _zef_abort

    export ZEPHYR_BASE="$workspace_zephyr"
}

# Unset Zephyr (West) workspace:
# - deactivate Python venv (restoring PATH)
# - unset ZEPHYR_BASE and board aliases.
_zef_workspace_unset() {
    deactivate
    unset ZEPHYR_BASE
    unset ZEPHYR_BOARD_ALIASES
    unset ZEF_WORKSPACE
}

_zef_toolchain_set() {
    if [ -f "$1/sdk_version" ]; then
        _zef_toolchain_zephyr_sdk "$1"
    elif [ -f "$1/bin/arm-none-eabi-gcc" ]; then
        _zef_toolchain_arm_gnu "$1"
    else
        _zef_abort "not a supported toolchain: $1"
    fi
}

_zef_toolchain_zephyr_sdk() {
    export ZEPHYR_SDK_INSTALL_DIR="$1"
    export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
    PATH="$ZEPHYR_SDK_INSTALL_DIR/sysroots/x86_64-pokysdk-linux/usr/bin:$PATH"
}

_zef_toolchain_arm_gnu() {
    export GNUARMEMB_TOOLCHAIN_PATH="$1"
    export ZEPHYR_TOOLCHAIN_VARIANT=gnuarmemb
    PATH="$GNUARMEMB_TOOLCHAIN_PATH/bin:$PATH"
    # To build without the Zephyr SDK’s prebuilt host tools,
    # the ZEPHYR_SDK_INSTALL_DIR environment variable must be unset.
    # See https://docs.zephyrproject.org/latest/develop/getting_started/installation_linux.html
    unset ZEPHYR_SDK_INSTALL_DIR
}

_zef_toolchain_unset() {
    unset ZEPHYR_SDK_INSTALL_DIR
    unset GNUARMEMB_TOOLCHAIN_PATH
    unset ZEPHYR_TOOLCHAIN_VARIANT
}

_zef_board_aliases_set() {
    if [ -f "$ZEF_XDG_BOARD_ALIASES" ]; then
		export ZEPHYR_BOARD_ALIASES="$ZEF_XDG_BOARD_ALIASES"
    fi
}

_zef_board_aliases_unset() {
	unset ZEPHYR_BOARD_ALIASES
}

_zef_wcomp_init() {
    if [ -z "$ZEF_COMP_SH" ]; then
        echo "West completion unavailable for $SHELL"
        return
    fi

    wcomp_file="$ZEF_WORKSPACE/west-completion.$ZEF_COMP_SH"

    if [ ! -f "$wcomp_file" ]; then
        echo 'West completion file does not exist, creating ...'
        west completion "$ZEF_COMP_SH" > "$wcomp_file"
    fi

    if [ -f "$wcomp_file" ]; then
        # shellcheck disable=SC1090
        . "$wcomp_file"
        echo "West completion from $wcomp_file"
    fi
}

_zef_wcomp_deinit() {
    if [ -z "$ZEF_COMP_SH" ]; then
        return
    fi

    # Should work for bash/zsh.
    # shellcheck disable=SC3044
    if complete -p west >/dev/null 2>&1; then
        # shellcheck disable=SC3044
        complete -r west
    fi
}

_zef_env_zephyr() {
    echo "Zephyr: $(_zef_zephyr_head)"
    echo "ZEPHYR_BASE: $ZEPHYR_BASE"
    echo "ZEPHYR_BOARD_ALIASES: $ZEPHYR_BOARD_ALIASES"
}

_zef_zephyr_head() {
    if [ -n "$ZEPHYR_BASE" ]; then
        git -C "$ZEPHYR_BASE" describe --always HEAD
    fi
}

_zef_env_toolchain() {
    if [ "$ZEPHYR_TOOLCHAIN_VARIANT" = "zephyr" ]; then
        echo "Toolchain: Zephyr SDK $(_zef_zephyr_sdk_version)"
        echo "ZEPHYR_SDK_INSTALL_DIR: $ZEPHYR_SDK_INSTALL_DIR"

    elif [ "$ZEPHYR_TOOLCHAIN_VARIANT" = "gnuarmemb" ]; then
        echo "Toolchain: $(_zef_armgnu_version)"
        echo "GNUARMEMB_TOOLCHAIN_PATH: $GNUARMEMB_TOOLCHAIN_PATH"
    fi
}


# Retrieve Zephyr SDK version from version file.
_zef_zephyr_sdk_version() {
    if [ -n "$ZEPHYR_SDK_INSTALL_DIR" ]; then
        cat "$ZEPHYR_SDK_INSTALL_DIR/sdk_version"
    fi
}

# Retrieve Arm GNU version from gcc.
_zef_armgnu_version() {
    if [ -n "$GNUARMEMB_TOOLCHAIN_PATH" ]; then
        arm_gnu_gcc="$GNUARMEMB_TOOLCHAIN_PATH/bin/arm-none-eabi-gcc"
        if [ -f  "$arm_gnu_gcc" ]; then
            $arm_gnu_gcc --version | head -n 1
        fi
    fi
}

_zef_env_python() {
    _zef_python_version
    echo "VIRTUAL_ENV: $VIRTUAL_ENV"
}

_zef_python_version() {
    python3 --version | head -n 1
}


_zef_assert_no_workspace() {
    if [ -n "$ZEF_WORKSPACE" ]; then
        _zef_abort 'a Zephyr development workspace is already active'
    fi
}

_zef_assert_workspace() {
    if [ -z "$ZEF_WORKSPACE" ]; then
        _zef_abort 'no active Zephyr development workspace'
    fi
}

_zef_assert_dir() {
    dirpath="$1"
    if [ ! -d "$dirpath" ]; then
        _zef_abort "not a directory: $dirpath"
    fi
}

# Output optional message to stderr
# and exit the function stack without exiting shell.
_zef_abort() {
    if [ -n "$1" ]; then
        echo "$1" 1>&2
    fi

    kill -INT $$
}
